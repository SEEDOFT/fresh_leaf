# Environment configuration for Fresh Leaf App
# =============================================
# Copy this file to .env.local for local development
# Copy this file to .env.prod for production builds
#
# IMPORTANT: Never commit actual .env files to version control!
# The .env files are gitignored to protect sensitive data.

# API Configuration
# This is the base URL for all API requests
API_URL=https://api.freshleaf.dev/api/v1

# Laravel Reverb WebSocket Configuration
REVERB_WS_SCHEME=wss
REVERB_WS_HOST=reverb.freshleaf.dev
REVERB_WS_PORT=443
REVERB_APP_KEY=your-reverb-app-key

# Optional override for private channel auth endpoint
# If empty, app uses <API origin>/broadcasting/auth
REVERB_AUTH_ENDPOINT=
